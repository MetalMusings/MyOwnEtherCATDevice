          <pdoEntry idx="686C" subIdx="00" bitLen="32" halPin="ax2-actual-velocity" halType="s32"/>
          <pdoEntry idx="68F4" subIdx="00" bitLen="32" halPin="ax2-following-error" halType="s32"/>
        </pdo>
        <pdo idx="1A02">
          <pdoEntry idx="7041" subIdx="00" bitLen="16" halPin="ax3-statusword" halType="u32"/>
