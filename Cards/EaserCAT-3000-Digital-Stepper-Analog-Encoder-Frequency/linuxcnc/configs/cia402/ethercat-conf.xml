<!--
  EaserCAT 3000 CiA402 (product code 0x3402), linuxcnc-ethercat "generic" configuration.

  The PDO layout below is the default mapping of the firmware. Positions are in steps,
  velocities in steps/s; the scaling to mm is done in HAL. The CiA402 state machine
  (controlword/statusword) must be handled in HAL, e.g. with a cia402 HAL component.

  DC: assignActivate 0x300 = SYNC0. The firmware requires a cycle of at least 250 us.
-->
<masters>
  <master idx="0" appTimePeriod="1000000" refClockSyncCycles="1000" syncToRefClock="true">
    <slave idx="0" type="generic" vid="0xd0bed1d0" pid="0x00003402" name="E3000" configPdos="true">
      <dcConf assignActivate="300" sync0Cycle="*1" sync0Shift="0"/>

      <!-- Step generator base period in ns (0x2000), 10000 = 100 kHz -->
      <sdoConfig idx="2000" subIdx="0"><sdoDataRaw data="10 27 00 00"/></sdoConfig>
      <!-- Example: invert the direction of axis 3 (0x707E polarity, bit 6 + 7) -->
      <!-- <sdoConfig idx="707E" subIdx="0"><sdoDataRaw data="C0"/></sdoConfig> -->
      <!-- Example: max acceleration axis 1 in steps/s^2 (0x60C5), 2000000 -->
      <!-- <sdoConfig idx="60C5" subIdx="0"><sdoDataRaw data="80 84 1E 00"/></sdoConfig> -->

      <syncManager idx="2" dir="out">
        <pdo idx="1600">
          <pdoEntry idx="6040" subIdx="00" bitLen="16" halPin="ax1-controlword" halType="u32"/>
          <pdoEntry idx="6060" subIdx="00" bitLen="8" halPin="ax1-opmode" halType="s32"/>
          <pdoEntry idx="607A" subIdx="00" bitLen="32" halPin="ax1-target-position" halType="s32"/>
          <pdoEntry idx="60FF" subIdx="00" bitLen="32" halPin="ax1-target-velocity" halType="s32"/>
          <pdoEntry idx="60FE" subIdx="01" bitLen="32" halType="complex">
            <complexEntry bitLen="16"/>
            <complexEntry bitLen="1" halPin="out-0" halType="bit"/>
            <complexEntry bitLen="1" halPin="out-1" halType="bit"/>
            <complexEntry bitLen="1" halPin="out-2" halType="bit"/>
            <complexEntry bitLen="1" halPin="out-3" halType="bit"/>
            <complexEntry bitLen="12"/>
          </pdoEntry>
        </pdo>
        <pdo idx="1601">
          <pdoEntry idx="6840" subIdx="00" bitLen="16" halPin="ax2-controlword" halType="u32"/>
          <pdoEntry idx="6860" subIdx="00" bitLen="8" halPin="ax2-opmode" halType="s32"/>
