        </pdo>
        <pdo idx="1A03">
          <pdoEntry idx="7841" subIdx="00" bitLen="16" halPin="ax4-statusword" halType="u32"/>
          <pdoEntry idx="7861" subIdx="00" bitLen="8" halPin="ax4-opmode-display" halType="s32"/>
          <pdoEntry idx="7864" subIdx="00" bitLen="32" halPin="ax4-actual-position" halType="s32"/>
