            <complexEntry bitLen="1" halPin="in-7" halType="bit"/>
            <complexEntry bitLen="8"/>
          </pdoEntry>
        </pdo>
        <pdo idx="1A01">
          <pdoEntry idx="6841" subIdx="00" bitLen="16" halPin="ax2-statusword" halType="u32"/>
          <pdoEntry idx="6861" subIdx="00" bitLen="8" halPin="ax2-opmode-display" halType="s32"/>
