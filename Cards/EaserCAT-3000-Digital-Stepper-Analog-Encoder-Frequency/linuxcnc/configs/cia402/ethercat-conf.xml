        </pdo>
        <pdo idx="1603">
          <pdoEntry idx="7840" subIdx="00" bitLen="16" halPin="ax4-controlword" halType="u32"/>
          <pdoEntry idx="7860" subIdx="00" bitLen="8" halPin="ax4-opmode" halType="s32"/>
          <pdoEntry idx="787A" subIdx="00" bitLen="32" halPin="ax4-target-position" halType="s32"/>
          <pdoEntry idx="78FF" subIdx="00" bitLen="32" halPin="ax4-target-velocity" halType="s32"/>
        </pdo>
        <pdo idx="1604">
          <pdoEntry idx="2101" subIdx="01" bitLen="8" halPin="enc-index-latch-enable" halType="bit"/>
          <pdoEntry idx="2101" subIdx="02" bitLen="32" halPin="enc-scale" halType="float-ieee"/>
          <pdoEntry idx="2102" subIdx="00" bitLen="32" halPin="analog-out-volt" halType="float-ieee"/>
        </pdo>
      </syncManager>

      <syncManager idx="3" dir="in">
        <pdo idx="1A00">
          <pdoEntry idx="6041" subIdx="00" bitLen="16" halPin="ax1-statusword" halType="u32"/>
          <pdoEntry idx="6061" subIdx="00" bitLen="8" halPin="ax1-opmode-display" halType="s32"/>
          <pdoEntry idx="6064" subIdx="00" bitLen="32" halPin="ax1-actual-position" halType="s32"/>
          <pdoEntry idx="606C" subIdx="00" bitLen="32" halPin="ax1-actual-velocity" halType="s32"/>
          <pdoEntry idx="60F4" subIdx="00" bitLen="32" halPin="ax1-following-error" halType="s32"/>
          <pdoEntry idx="60FD" subIdx="00" bitLen="32" halType="complex">
            <complexEntry bitLen="16"/>
            <complexEntry bitLen="1" halPin="in-0" halType="bit"/>
            <complexEntry bitLen="1" halPin="in-1" halType="bit"/>
            <complexEntry bitLen="1" halPin="in-2" halType="bit"/>
            <complexEntry bitLen="1" halPin="in-3" halType="bit"/>
